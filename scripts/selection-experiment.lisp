;;; Development and final evaluation use separate processes and input manifests.
(load (merge-pathnames "experiment-common.lisp" *load-truename*))

(defun selection-train (model cases fixtures output device protocol)
  (let ((validation (remove-if-not (lambda (c) (string= "validation" (gethash "split" c))) cases))
        (examples nil) (losses nil) (step 0))
    (dolist (case cases)
      (unless (and (member (gethash "split" case) '("train" "validation") :test #'equal)
                   (eq (not (null (gethash "answer" case))) (string= "train" (gethash "split" case))))
        (error "Development manifest must isolate training/validation.")))
    (experiment-generate model validation fixtures output "step-0" device protocol)
    (unwind-protect
         (progn
           (dolist (case cases)
             (when (string= "train" (gethash "split" case))
               (let ((name (gethash "name" case)))
                 (format t "~&Preparing ~A~%" name) (finish-output)
                 (multiple-value-bind (ids labels attention features tiles start)
                     (docling:prepare-image-training-example model
                       (merge-pathnames (format nil "~A.png" name) fixtures) (gethash "answer" case)
                       :task (gethash "task" protocol))
                   (push (list name ids labels attention features tiles start) examples)))))
           (setf examples (nreverse examples))
           (docling:make-document-lora model :rank (gethash "rank" protocol)
                                            :alpha (gethash "alpha" protocol) :seed (gethash "seed" protocol))
           (tb:with-resource (optimizer (tb:make-adamw
                                         :learning-rate (gethash "learning_rate" protocol)
                                         :beta1 (gethash "beta1" protocol) :beta2 (gethash "beta2" protocol)
                                         :epsilon (gethash "epsilon" protocol) :weight-decay (gethash "weight_decay" protocol)))
             (dotimes (epoch (gethash "epochs" protocol))
               (dolist (example examples)
                 (destructuring-bind (name ids labels attention features tiles start) example
                   (let ((loss (docling:document-train-step model optimizer ids features
                                  :labels labels :attention-mask attention :tile-count tiles
                                  :max-grad-norm (gethash "max_grad_norm" protocol))))
                     (incf step)
                     (push (experiment-object "step" step "epoch" (1+ epoch) "page" name "loss" loss
                                              "tiles" tiles "prompt_tokens" start "positions" (array-dimension ids 1)) losses)
                     (format t "~&Step ~D ~A: ~,8F~%" step name loss) (finish-output))))
               (when (member (1+ epoch) (gethash "candidate_epochs" protocol))
                 (docling:save-document-adapter model (merge-pathnames (format nil "adapter-~D/" step) output))
                 (experiment-generate model validation fixtures output (format nil "step-~D" step) device protocol))))
           (experiment-write (merge-pathnames "losses.json" output) (coerce (nreverse losses) 'vector) t))
      (dolist (example examples) (tb:dispose (fifth example))))))

(let* ((args (uiop:command-line-arguments))
       (mode (first args))
       (fixtures (uiop:ensure-directory-pathname (second args)))
       (output (uiop:ensure-directory-pathname (third args)))
       (filename (cond ((equal mode "train") "development.json") ((equal mode "final") "final.json")
                       (t (error "Expected train or final mode."))))
       (manifest (with-open-file (s (merge-pathnames filename fixtures)) (yason:parse s)))
       (cases (gethash "cases" manifest)) (protocol (gethash "protocol" manifest))
       (device (ecase (intern (string-upcase (or (uiop:getenv "TB_DEVICE") "gpu")) :keyword) (:cpu :cpu) (:gpu :gpu))))
  (when (probe-file output) (error "Output must be new: ~A" output))
  (ensure-directories-exist output)
  (tb:with-resource (model (docling:load-document-model (or (uiop:getenv "DOCLING_MODEL") (error "Set DOCLING_MODEL."))
                                                     :device device))
    (if (equal mode "train")
        (selection-train model cases fixtures output device protocol)
        (progn
          (dolist (case cases)
            (unless (and (member (gethash "split" case) '("final" "regression") :test #'equal)
                         (not (gethash "answer" case)))
              (error "Final manifest must exclude training and all answers.")))
          (experiment-generate model cases fixtures output "base" device protocol)
          (unless (equal (fourth args) "base")
            (docling:load-document-adapter model (uiop:ensure-directory-pathname (fourth args))))
          (experiment-generate model cases fixtures output "adapted" device protocol)))))
