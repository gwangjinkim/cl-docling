;;; Staged public-API benchmark; independent high-level API parity before samples.
(load (merge-pathnames "experiment-common.lisp" *load-truename*))

(defun bench-now () (/ (get-internal-real-time) (float internal-time-units-per-second 1d0)))

(defun bench-next (model ids cache backend &optional features (tiles 1))
  (tb:with-resource (logits (docling:forward-document model ids :cache cache :image-features features :tile-count tiles))
    (tbk:with-backend (backend) (tbk:greedy-token logits))))

(defun bench-page (model backend file)
  (tb:reset-backend-peak-memory backend)
  (let* ((start (bench-now)) (tokens (make-array 0 :element-type '(unsigned-byte 32) :adjustable t :fill-pointer 0))
         (reason :length) (t1 nil) (t2 nil) (t3 nil) (t4 nil) (t5 nil) (raw nil))
    (multiple-value-bind (ids pixels tiles) (docling:prepare-image-input model file)
      (setf t1 (bench-now))
      (tb:with-resource (features (docling:document-tile-features model pixels))
        (tbk:with-backend (backend) (tbk:evaluate features))
        (setf t2 (bench-now))
        (tb:with-resource (cache (tb:make-cache model))
          (vector-push-extend (bench-next model ids cache backend features tiles) tokens)
          (setf t3 (bench-now))
          (loop while (and (< (length tokens) 512) (/= (aref tokens (1- (length tokens))) 49279))
                do (vector-push-extend
                    (bench-next model (make-array '(1 1) :initial-element (aref tokens (1- (length tokens)))) cache backend) tokens)))
        (setf t4 (bench-now)
              reason (if (= (aref tokens (1- (length tokens))) 49279) :eos :length)
              raw (tb:decode-tokens model tokens)
              t5 (bench-now)))
      (let* ((generation (- (bench-now) start))
             (parse-start (bench-now))
             (document (docling:parse-doctags raw :token-ids tokens :stop-reason reason))
             (markdown (handler-case (docling:document-to-markdown document) (docling:document-error () nil)))
             (parse-time (- (bench-now) parse-start))
             (memory (tb:backend-memory backend)))
        (values
         (experiment-object "tokens" tokens "raw" raw "stop_reason" (string-downcase reason)
                            "prompt_ids" (make-array (array-dimension ids 1) :displaced-to ids :element-type '(unsigned-byte 32))
                            "tiles" tiles "diagnostics" (length (docling:parsed-document-diagnostics document))
                            "markdown_available" (if markdown yason:true yason:false))
         (experiment-object "preprocess" (- t1 start) "vision" (- t2 t1) "prefill" (- t3 t2)
                            "decode" (- t4 t3) "detokenize" (- t5 t4) "generation" generation
                            "parse_markdown" parse-time "mlx_peak_bytes" (getf memory :peak)
                            "mlx_active_bytes" (getf memory :active) "mlx_cache_bytes" (getf memory :cache)
                            "native_handles" (getf memory :handles)))))))

(let* ((output (first (uiop:command-line-arguments)))
       (device (ecase (intern (string-upcase (or (uiop:getenv "TB_DEVICE") "cpu")) :keyword) (:cpu :cpu) (:gpu :gpu)))
       (checkpoint (uiop:ensure-directory-pathname (or (uiop:getenv "DOCLING_MODEL") (error "Set DOCLING_MODEL.")))))
  (when (probe-file output) (error "Output must be new."))
  (with-open-file (s (merge-pathnames "generation_config.json" checkpoint))
    (unless (= 49279 (gethash "eos_token_id" (yason:parse s))) (error "Unqualified EOS.")))
  (let ((load-start (bench-now)) (cases (make-hash-table :test #'equal)))
    (tb:with-resource (backend (tb:make-backend :device device))
      (tb:with-resource (model (docling:load-document-model checkpoint :backend backend))
        (when (uiop:getenv "DOCLING_BENCHMARK_ADAPTER")
          (docling:load-document-adapter model (uiop:getenv "DOCLING_BENCHMARK_ADAPTER")))
        (tbk:with-backend (backend)
          (dolist (entry (append (tb:named-parameters model)
                                (when (uiop:getenv "DOCLING_BENCHMARK_ADAPTER")
                                  (docling:document-lora-parameters model))))
            (unless (eq :float32 (tb:tensor-dtype (cdr entry))) (error "Expected FP32 weights."))
            (tbk:evaluate (cdr entry))))
        (let* ((load-memory (tb:backend-memory backend)) (load-time (- (bench-now) load-start))
               (base-handles (getf load-memory :handles)))
          (dolist (entry (if (uiop:getenv "DOCLING_BENCHMARK_CASES")
                            (with-open-file (s (uiop:getenv "DOCLING_BENCHMARK_CASES"))
                              (loop for name being the hash-keys of (yason:parse s) using (hash-value path)
                                    collect (cons name path)))
                            '(("native-page" . "examples/data/native-page.png")
                           ("grid" . "tests/fixtures/table-pages/grid.png")
                           ("merged" . "tests/fixtures/table-pages/merged.png"))))
            (let* ((name (car entry)) (file (asdf:system-relative-pathname "cl-docling" (cdr entry))) (samples nil))
              (format t "~&Native ~A: ~A correctness call and warm-up~%" device name) (finish-output)
              (multiple-value-bind (public-raw public-tokens public-reason) (docling:generate-image model file :max-new-tokens 512)
                (multiple-value-bind (result warmup) (bench-page model backend file)
                  (unless (and (equal public-raw (gethash "raw" result)) (equalp public-tokens (gethash "tokens" result))
                               (equal (string-downcase public-reason) (gethash "stop_reason" result)))
                    (error "Staged/public generation mismatch."))
                  (dotimes (repeat 3)
                    (multiple-value-bind (again sample) (bench-page model backend file)
                      (dolist (key '("raw" "tokens" "prompt_ids" "tiles" "stop_reason" "diagnostics" "markdown_available"))
                        (unless (equalp (gethash key result) (gethash key again)) (error "Non-repeatable ~A" key)))
                      (unless (= base-handles (gethash "native_handles" sample)) (error "Native tensor handle leak."))
                      (push sample samples)
                      (format t "~&~A sample ~D: ~,4F seconds, ~D tokens~%" name (1+ repeat)
                              (gethash "generation" sample) (length (gethash "tokens" result))) (finish-output)))
                  (setf (gethash "samples" result) (coerce (nreverse samples) 'vector)
                        (gethash "warmup" result) warmup
                        (gethash "public_api_equal" result) yason:true
                        (gethash name cases) result)))))
          (experiment-write output
            (experiment-object "runtime" "lisp-mlx" "device" (string-downcase (tb:backend-device backend))
                               "dtype" "float32" "max_new_tokens" 512 "task" "Convert this page to docling."
                               "warmups" 1 "extra_public_api_checks_per_case" 1 "repeats" 3
                               "load_seconds" load-time "load_mlx_peak_bytes" (getf load-memory :peak)
                               "lisp_version" (lisp-implementation-version) "cases" cases) t))))))
